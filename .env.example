# Nyavodroid - OnC Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# Facebook API Configuration
# ============================================================================
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_page_access_token
VIS_FB_PAGE_ID=your_vis_facebook_page_id
VIS_FB_PAGE_TOKEN=your_vis_page_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# ============================================================================
# AI Text Generation Providers
# ============================================================================
GEMINI_API_KEY_CONTENT=your_gemini_api_key_for_content
GEMINI_API_KEY_STORY=your_gemini_api_key_for_stories
MISTRAL_API_KEY=your_mistral_api_key
TOGETHER_API_KEY=your_together_api_key
HF_TOKEN=your_huggingface_api_token

# ============================================================================
# AI Image Generation Providers
# ============================================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID_2=your_cloudflare_account_id_2
CLOUDFLARE_API_TOKEN_2=your_cloudflare_api_token_2
CLOUDFLARE_ACCOUNT_ID_3=your_cloudflare_account_id_3
CLOUDFLARE_API_TOKEN_3=your_cloudflare_api_token_3
FREEAI_API_KEY=your_freeai_api_key
FAL_API_KEY=your_fal_api_key
REPLICATE_API_TOKEN=your_replicate_api_token

# ============================================================================
# Search & Verification
# ============================================================================
TAVILY_API_KEY=your_tavily_api_key
PEXELS_API_KEY=your_pexels_api_key

# ============================================================================
# Control Variables
# ============================================================================
# Brand Selection: 'nyavo' or 'vis'
BRAND=nyavo

# Strategy Configuration (JSON payload for content selection)
STRATEGIE_JSON='{"format": "image_texte", "pilier": "secrets_code"}'

# Force Format (override strategy-based format selection)
# Options: texte_seul, image_texte, reel
FORCE_FORMAT=

# VIS Brand Controls
VIS_FORCE_PILIER=aleatoire  # Options: aleatoire, parabole, morale, question, story
VIS_EXCLUDE=story           # Comma-separated list of pillars to exclude
VIS_DRY_RUN=0              # Set to 1 to skip actual Facebook publishing (0 = publish)

# ============================================================================
# Notes
# ============================================================================
# - All AI provider keys are optional but recommended for full functionality
# - Missing provider keys will be silently skipped (fallback to next provider)
# - Facebook tokens are REQUIRED for publishing
# - Tavily is REQUIRED for fact-checking (Nyavo image_texte posts)
# - Set VIS_DRY_RUN=1 to test VIS workflows without publishing
